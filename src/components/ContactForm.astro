---
import { FORMSPREE_FORM_ID } from "../lib/constants";
import { client } from "../lib/client";

const action = `https://formspree.io/f/${FORMSPREE_FORM_ID}`;
const b = client.business;
const channels = new Set(client.contact.channels.selected);
const phone = channels.has("phone") && b.phone ? b.phone : "";
const email = channels.has("email") && b.email ? b.email : "";
---

<section
  id="ecrire"
  class="page-block contact-form"
  aria-labelledby="contact-form-heading"
  data-component="contact.form"
>
  <h2 id="contact-form-heading">Envoyer un message</h2>

  <div class="contact-form__sent" data-form-sent hidden tabindex="-1" role="status">
    <p class="contact-form__sent-title">Merci, votre message a bien été envoyé.</p>
    <p class="note">
      Il m’est transmis directement.
      {phone && (
        <>
          Pour toute précision, vous pouvez aussi m’appeler au{" "}
          <a href={`tel:${phone.replace(/\s/g, "")}`} class="whitespace-nowrap">{phone}</a>.
        </>
      )}
    </p>
  </div>

  <form class="space-y-4" method="POST" action={action} data-contact-form>
    <input
      type="hidden"
      name="_subject"
      value={`Message depuis le site — ${client.seo.siteName}`}
    />

    <p class="sr-only" inert>
      <label>
        Ne pas remplir ce champ
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="grid gap-4 md:grid-cols-2">
      <div class="contact-form__field">
        <label for="contact-name">
          Nom <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          maxlength="120"
          autocomplete="name"
          class="form-field"
          aria-describedby="contact-name-error"
          data-error-missing="Indiquez votre nom."
        />
        <p id="contact-name-error" class="contact-form__error" data-field-error hidden></p>
      </div>

      <div class="contact-form__field">
        <label for="contact-email">
          E-mail <span aria-hidden="true">*</span>
        </label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          class="form-field"
          aria-describedby="contact-email-error"
          data-error-missing="Indiquez votre adresse e-mail pour que je puisse vous répondre."
          data-error-invalid="Cette adresse semble incomplète (exemple&nbsp;: prenom.nom@domaine.fr)."
        />
        <p id="contact-email-error" class="contact-form__error" data-field-error hidden></p>
      </div>
    </div>

    <div class="contact-form__field">
      <label for="contact-phone">Téléphone <span class="note">(facultatif)</span></label>
      <input
        id="contact-phone"
        name="phone"
        type="tel"
        maxlength="30"
        autocomplete="tel"
        class="form-field"
      />
    </div>

    <div class="contact-form__field">
      <label for="contact-message">
        Message <span aria-hidden="true">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        required
        rows={5}
        maxlength="5000"
        class="form-field"
        aria-describedby="contact-message-error"
        data-error-missing="Écrivez quelques mots sur votre demande."
      ></textarea>
      <p id="contact-message-error" class="contact-form__error" data-field-error hidden></p>
      <p class="note">Les champs marqués d’un * sont obligatoires.</p>
    </div>

    <p class="note">Votre message m’est transmis par e-mail via le service Formspree.</p>

    <div class="contact-form__failure" data-form-failure hidden tabindex="-1" role="alert">
      <p>
        <strong>Le message n’a pas pu être envoyé.</strong> Ce que vous avez écrit est conservé&nbsp;:
        vous pouvez réessayer
        {(phone || email) && " ou me joindre directement"}
        {phone && (
          <>
            {" "}au <a href={`tel:${phone.replace(/\s/g, "")}`} class="whitespace-nowrap">{phone}</a>
          </>
        )}
        {phone && email && " ou"}
        {email && (
          <>
            {" "}à <a href={`mailto:${email}`}>{email}</a>
          </>
        )}.
      </p>
    </div>

    <button type="submit" class="cta-primary" data-submit>
      <span data-submit-label>Envoyer le message</span>
    </button>
  </form>
</section>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;

  function fieldError(field: Field): string {
    const v = field.validity;
    if (v.valid) return "";
    if (v.valueMissing) return field.dataset.errorMissing ?? "Ce champ est obligatoire.";
    if (v.typeMismatch) return field.dataset.errorInvalid ?? "Ce format n’est pas reconnu.";
    if (v.tooLong) return "Ce texte est trop long.";
    return field.validationMessage;
  }

  function showError(field: Field): boolean {
    const message = fieldError(field);
    const slot = field.parentElement?.querySelector<HTMLElement>("[data-field-error]");
    field.toggleAttribute("aria-invalid", Boolean(message));
    if (slot) {
      slot.textContent = message;
      slot.hidden = !message;
    }
    return !message;
  }

  function enhance(form: HTMLFormElement): void {
    const section = form.closest<HTMLElement>('[data-component="contact.form"]');
    const sent = section?.querySelector<HTMLElement>("[data-form-sent]");
    const failure = form.querySelector<HTMLElement>("[data-form-failure]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const fields = [...form.querySelectorAll<Field>("input[required], textarea[required]")];
    const idleLabel = submitLabel?.textContent ?? "";
    let sending = false;

    // Les messages natifs du navigateur sont remplacés par des erreurs sous chaque champ.
    form.noValidate = true;

    for (const field of fields) {
      // Erreur affichée à la sortie du champ, puis corrigée au fil de la saisie.
      field.addEventListener("blur", () => {
        if (field.value.trim() || field.hasAttribute("aria-invalid")) showError(field);
      });
      field.addEventListener("input", () => {
        if (field.hasAttribute("aria-invalid")) showError(field);
      });
    }

    function setSending(state: boolean): void {
      sending = state;
      if (submit) {
        submit.disabled = state;
        submit.setAttribute("aria-busy", String(state));
      }
      if (submitLabel) submitLabel.textContent = state ? "Envoi en cours…" : idleLabel;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending) return;

      // Un champ rempli d'espaces seulement compte comme vide.
      for (const field of fields) if (!field.value.trim()) field.value = "";
      const invalid = fields.filter((field) => !showError(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      if (failure) failure.hidden = true;
      setSending(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.reset();
        form.hidden = true;
        if (sent) {
          sent.hidden = false;
          sent.focus();
        }
      } catch {
        if (failure) {
          failure.hidden = false;
          failure.focus();
        }
      } finally {
        setSending(false);
      }
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-contact-form]")) {
    enhance(form);
  }
</script>
