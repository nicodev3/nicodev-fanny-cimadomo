---
import { CalendarX, CircleAlert, Hourglass, Lock, UserX } from "@lucide/astro";
import { client } from "../lib/client";
import { professionConditionsConfidentialitySummary } from "../lib/client/professionCopy.ts";
import { CONDITIONS_LIMITS_ITEMS } from "../lib/constants";

const confidentialitySummary = professionConditionsConfidentialitySummary(client.profession);

const c = client.conditions;
---

<section class="page-block" data-component="panel.conditions" aria-labelledby="conditions-title">
  <div class="pricing-section__head">
    <p class="pricing-eyebrow">Cadre</p>
    <h2 id="conditions-title">Conditions du suivi</h2>
  </div>

  <ul class="conditions-grid">
    <li class="condition-card" data-component="conditions.cancellation">
      <span class="pricing-panel__icon" aria-hidden="true"><CalendarX size={20} /></span>
      <h3>Annulation</h3>
      <p class="condition-card__key">{c.cancellation.noticeHours} h à l’avance</p>
      <p class="note">{c.cancellation.feePolicy}</p>
    </li>

    <li class="condition-card" data-component="conditions.delay">
      <span class="pricing-panel__icon" aria-hidden="true"><Hourglass size={20} /></span>
      <h3>Retard</h3>
      <p class="condition-card__key">Tolérance : {c.delay.graceMinutes} min</p>
      <p class="note">{c.delay.note}</p>
    </li>

    <li class="condition-card" data-component="conditions.no-show">
      <span class="pricing-panel__icon" aria-hidden="true"><UserX size={20} /></span>
      <h3>Absence non signalée</h3>
      <p class="condition-card__key">{c.noShow.charged ? "Séance due" : "Non facturée"}</p>
      <p class="note">{c.noShow.note}</p>
    </li>
  </ul>

  <div class="conditions-notes">
    <p class="conditions-note" data-component="conditions.confidentiality">
      <Lock size={18} aria-hidden="true" />
      <span>{confidentialitySummary}</span>
    </p>

    <div
      class="conditions-note conditions-note--alert"
      data-component="conditions.limits"
      role="note"
    >
      <CircleAlert size={18} aria-hidden="true" />
      <div>
        <p class="conditions-note__title">Limites du suivi</p>
        <ul>
          {CONDITIONS_LIMITS_ITEMS.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
