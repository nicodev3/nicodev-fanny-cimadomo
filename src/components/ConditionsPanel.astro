---
import { CircleAlert } from "@lucide/astro";
import { client } from "../lib/client";
import { professionConditionsConfidentialitySummary } from "../lib/client/professionCopy.ts";
import { CONDITIONS_LIMITS_ITEMS } from "../lib/constants";

const confidentialitySummary = professionConditionsConfidentialitySummary(client.profession);
const c = client.conditions;
const sessionPrice = client.pricing.items[0]?.price;
const dueAmount =
  c.noShow.charged && sessionPrice
    ? ` (${sessionPrice}\u00a0€)`
    : "";
---

<section class="page-block" data-component="panel.conditions" aria-labelledby="conditions-title">
  <h2 id="conditions-title">Annulation, retard et absence</h2>

  <ul class="rule-list">
    <li data-component="conditions.cancellation">
      <h3>Annulation</h3>
      <p>
        Prévenez-moi au moins {c.cancellation.noticeHours} heures à l’avance, hors samedi, dimanche
        et jours fériés. {c.cancellation.feePolicy}
      </p>
    </li>

    <li data-component="conditions.delay">
      <h3>Retard</h3>
      <p>
        Au-delà de {c.delay.graceMinutes} minutes, {c.delay.note}
      </p>
    </li>

    <li data-component="conditions.no-show">
      <h3>Absence</h3>
      <p>
        {c.noShow.note}
        {dueAmount}.
      </p>
    </li>
  </ul>

  <p class="conditions-confidentiality" data-component="conditions.confidentiality">
    {confidentialitySummary}
  </p>

  <div class="conditions-note conditions-note--alert" data-component="conditions.limits" role="note">
    <CircleAlert size={18} aria-hidden="true" />
    <div>
      <p class="conditions-note__title">Urgences</p>
      <ul>
        {CONDITIONS_LIMITS_ITEMS.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
