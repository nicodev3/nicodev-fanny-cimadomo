---
import { CalendarDays, Mail, MapPin, MessageCircle, Phone } from "@lucide/astro";
import { client } from "../lib/client";
import { businessAddressText, businessStreetLines } from "../lib/client/businessAddress";
import { resolvedBookingPrimaryHref } from "../lib/client/siteBooking";
import { resolvedWhatsappHref } from "../lib/client/whatsapp";

interface Props {
  stacked?: boolean;
}

const { stacked = false } = Astro.props;
const b = client.business;
const channels = new Set(client.contact.channels.selected);
const accessNote = client.contact.accessNote ?? "";
---

<section class="info-card contact-card" data-component="contact.card">
  <div class:list={["contact-card__grid", !stacked && "contact-card__grid--split"]}>
    <div class="contact-card__body">
      <span class="icon-badge" aria-hidden="true"><MapPin size={20} /></span>
      <h2>Le cabinet</h2>
      <address class="contact-card__address">
        Cabinet {b.fullName}<br />
        {
          businessStreetLines(b).map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
        {`${b.postalCode} ${b.city}`}
      </address>
      {accessNote && <p class="contact-card__access note">{accessNote}</p>}

      <ul class="contact-card__channels">
        {
          channels.has("phone") && (
            <li>
              <Phone size={18} aria-hidden="true" />
              <a href={`tel:${b.phone.replace(/\s/g, "")}`}>{b.phone}</a>
            </li>
          )
        }
        {
          channels.has("email") && (
            <li>
              <Mail size={18} aria-hidden="true" />
              <a href={`mailto:${b.email}`}>{b.email}</a>
            </li>
          )
        }
        {
          channels.has("other") && client.contact.channels.other && (
            <li>
              <MessageCircle size={18} aria-hidden="true" />
              <span>{client.contact.channels.other}</span>
            </li>
          )
        }
      </ul>
      {
        (channels.has("whatsapp") || channels.has("doctolib")) && (
          <div class="booking-actions">
            {channels.has("whatsapp") && (
              <a
                href={resolvedWhatsappHref(client)}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-secondary cta-secondary--sm"
              >
                <MessageCircle class="size-4 shrink-0" size={16} aria-hidden="true" />
                WhatsApp
                <span class="sr-only">(nouvel onglet)</span>
              </a>
            )}
            {channels.has("doctolib") && (
              <a
                href={resolvedBookingPrimaryHref(client)}
                target="_blank"
                rel="noopener noreferrer"
                class="cta-secondary cta-secondary--sm"
              >
                <CalendarDays class="size-4 shrink-0" size={16} aria-hidden="true" />
                Message via Doctolib
                <span class="sr-only">(nouvel onglet)</span>
              </a>
            )}
          </div>
        )
      }
    </div>
    <div
      class="contact-card__map"
      data-component="contact.map"
      data-map-address={businessAddressText(b)}
      data-map-name={b.fullName}
      role="region"
      aria-label={`Plan d’accès au cabinet, ${businessAddressText(b)}`}
    >
    </div>
  </div>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  const ZOOM = 16;

  async function geocodeAddress(address: string): Promise<L.LatLngTuple | null> {
    const endpoint = new URL("https://nominatim.openstreetmap.org/search");
    endpoint.searchParams.set("format", "jsonv2");
    endpoint.searchParams.set("limit", "1");
    endpoint.searchParams.set("countrycodes", "fr");
    endpoint.searchParams.set("accept-language", "fr");
    endpoint.searchParams.set("q", address);

    try {
      const response = await fetch(endpoint, { headers: { Accept: "application/json" } });
      if (!response.ok) return null;
      const results: unknown = await response.json();
      if (!Array.isArray(results) || results.length === 0) return null;
      const { lat, lon } = results[0] as { lat: string; lon: string };
      return [Number.parseFloat(lat), Number.parseFloat(lon)];
    } catch {
      return null;
    }
  }

  /** Carte affichée uniquement si l’adresse est géocodée ; sinon le bloc est masqué. */
  async function initMap(el: HTMLElement): Promise<void> {
    const address = el.dataset.mapAddress;
    if (!address) return;

    const coords = await geocodeAddress(address);
    if (!coords) {
      el.hidden = true;
      return;
    }

    const map = L.map(el, { scrollWheelZoom: false }).setView(coords, ZOOM);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 20,
    }).addTo(map);
    L.marker(coords)
      .addTo(map)
      .bindPopup(`${el.dataset.mapName ?? "Cabinet"}<br>${address}`);
  }

  for (const el of document.querySelectorAll<HTMLElement>('[data-component="contact.map"]')) {
    initMap(el);
  }
</script>
