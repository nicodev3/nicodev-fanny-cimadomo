---
const items = [
  "Des souvenirs répétés, pénibles et involontaires de l’expérience stressante ?",
  "Des rêves répétés et pénibles de l’expérience stressante ?",
  "Avoir soudain l’impression de revivre l’expérience stressante, ou agir comme si elle se produisait à nouveau (comme si vous étiez réellement en train de la revivre) ?",
  "Être très bouleversé(e) quand quelque chose vous a rappelé l’expérience stressante ?",
  "Avoir de fortes réactions physiques quand quelque chose vous a rappelé l’expérience stressante (par exemple, battements de cœur, difficultés à respirer, sueurs) ?",
  "Éviter les souvenirs, pensées ou sentiments liés à l’expérience stressante ?",
  "Éviter les rappels externes de l’expérience stressante (par exemple, des personnes, des endroits, des conversations, des activités, des objets ou des situations) ?",
  "Avoir du mal à vous rappeler des parties importantes de l’expérience stressante ?",
  "Avoir de fortes croyances négatives à propos de vous-même, des autres ou du monde (par exemple, avoir des pensées telles que : je suis mauvais(e), il y a quelque chose qui ne va vraiment pas chez moi, on ne peut faire confiance à personne, le monde est complètement dangereux) ?",
  "Vous blâmer ou blâmer quelqu’un d’autre pour l’expérience stressante ou ce qui s’est produit après ?",
  "Avoir de fortes émotions négatives telles que la peur, l’horreur, la colère, la culpabilité ou la honte ?",
  "Perdre de l’intérêt pour des activités que vous aimiez auparavant ?",
  "Vous sentir distant(e) ou coupé(e) des autres ?",
  "Avoir du mal à ressentir des émotions positives (par exemple, être incapable de ressentir de la joie ou de l’affection envers vos proches) ?",
  "Un comportement irritable, des bouffées de colère ou un comportement agressif ?",
  "Prendre trop de risques ou faire des choses qui pourraient vous blesser ?",
  "Être en état de « super-alerte », vigilant(e) ou sur vos gardes ?",
  "Sursauter facilement ?",
  "Avoir du mal à vous concentrer ?",
  "Avoir du mal à vous endormir ou à rester endormi(e) ?",
];

const scale = [
  { value: 0, label: "Pas du tout" },
  { value: 1, label: "Un petit peu" },
  { value: 2, label: "Modérément" },
  { value: 3, label: "Beaucoup" },
  { value: 4, label: "Extrêmement" },
];

const clusters = [
  { id: "b", label: "Reviviscences", from: 1, to: 5, max: 20 },
  { id: "c", label: "Évitement", from: 6, to: 7, max: 8 },
  { id: "d", label: "Cognitions et humeur", from: 8, to: 14, max: 28 },
  { id: "e", label: "Hyperactivation", from: 15, to: 20, max: 24 },
];
---

<section
  id="pcl5"
  class="pcl5 page-block"
  aria-labelledby="pcl5-heading"
  data-component="questionnaire.pcl5"
>
  <h2 id="pcl5-heading">Questionnaire PCL-5 : repérer les symptômes post-traumatiques</h2>
  <p>
    La PCL-5 (<em>PTSD Checklist for DSM-5</em>) est un questionnaire de 20 questions qui évalue les
    symptômes du stress post-traumatique au cours du dernier mois.
  </p>
  <p class="note">
    Ce questionnaire est un outil de repérage : il ne constitue pas un diagnostic. Vos réponses
    restent sur votre appareil, elles ne sont ni enregistrées ni transmises. Seul(e) un(e)
    professionnel(le) peut interpréter ces résultats avec vous.
  </p>

  <form class="pcl5__form space-y-6" novalidate>
    <div class="pcl5__progress" hidden>
      <div class="pcl5__progress-row">
        <p id="pcl5-progress-label" class="pcl5__progress-label">
          <span data-step-label>Question 1 sur 20</span>
          <span class="pcl5__cluster" data-cluster>{clusters[0].label}</span>
        </p>
        <p class="pcl5__progress-count">
          <span data-answered>0</span>
          <span aria-hidden="true">/</span>
          <span class="sr-only"> sur </span>20
        </p>
      </div>
      <div
        class="pcl5__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="20"
        aria-valuenow="0"
        aria-labelledby="pcl5-progress-label"
        data-track
      >
        <div class="pcl5__fill" data-fill></div>
      </div>
    </div>

    <p class="pcl5__consigne" data-consigne>
      <strong>Consigne.</strong> Voici une liste de problèmes que les gens ont parfois à la suite d’une
      expérience très stressante. Pensez à cette expérience et lisez attentivement chaque problème. Indiquez
      à quel point vous avez été gêné(e) par chacun d’eux <strong>au cours du dernier mois</strong>.
    </p>

    <p class="pcl5__lead"><strong>Au cours du dernier mois, avez-vous été gêné(e) par :</strong></p>

    <p class="sr-only" aria-live="polite" data-live></p>

    {
      items.map((text, i) => (
        <fieldset class="pcl5__item" data-item data-index={i}>
          <legend>
            <span class="pcl5__num">{i + 1}.</span> {text}
          </legend>
          <div class="pcl5__choices">
            {scale.map((s) => (
              <label class="pcl5__choice">
                <input type="radio" name={`q${i + 1}`} value={s.value} />
                <span class="pcl5__choice-face">
                  <span class="pcl5__score" aria-hidden="true">
                    {s.value}
                  </span>
                  <span class="pcl5__choice-label">{s.label}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <p class="pcl5__error" role="alert" hidden></p>

    <div class="pcl5__nav" hidden>
      <button type="button" class="cta-secondary" data-prev disabled>Précédent</button>
      <button type="button" class="cta-primary" data-next disabled>Continuer</button>
      <button type="reset" class="pcl5__restart">Recommencer</button>
    </div>

    <div class="pcl5__actions">
      <button type="submit" class="cta-primary">Calculer mon score</button>
      <button type="reset" class="cta-secondary">Recommencer</button>
    </div>
  </form>

  <div class="pcl5__result" role="status" aria-live="polite" tabindex="-1" hidden inert>
    <h3>Votre résultat</h3>
    <p class="pcl5__total">
      <span data-total></span>
      <span class="pcl5__total-unit"> sur 80</span>
    </p>
    <p data-message></p>
    <ul class="pcl5__details">
      {
        clusters.map((cluster) => {
          const range =
            cluster.to === cluster.from
              ? `question ${cluster.from}`
              : cluster.to === cluster.from + 1
                ? `questions ${cluster.from} et ${cluster.to}`
                : `questions ${cluster.from} à ${cluster.to}`;
          return (
            <li>
              <span>
                {cluster.label}
                <span class="pcl5__details-range"> ({range})</span>
              </span>
              <span>
                <span data-cluster-score={cluster.id}></span>
                <span class="pcl5__over"> / {cluster.max}</span>
              </span>
            </li>
          );
        })
      }
    </ul>
    <p class="note">
      Un score égal ou supérieur à 33 suggère la présence possible d’un trouble de stress
      post-traumatique et justifie une évaluation clinique. Un score plus bas n’exclut pas une
      souffrance réelle. En cas de détresse importante ou d’idées suicidaires, contactez le 3114
      (numéro national de prévention du suicide, 24 h/24) ou le 15.
    </p>
    <div class="pcl5__result-actions">
      <button type="button" class="cta-secondary" data-edit>Modifier mes réponses</button>
    </div>
  </div>
</section>

<script>
  const clusters = [
    { id: "b", label: "Reviviscences", from: 1, to: 5 },
    { id: "c", label: "Évitement", from: 6, to: 7 },
    { id: "d", label: "Cognitions et humeur", from: 8, to: 14 },
    { id: "e", label: "Hyperactivation", from: 15, to: 20 },
  ] as const;

  const root = document.querySelector<HTMLElement>('[data-component="questionnaire.pcl5"]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>(".pcl5__form")!;
    const error = root.querySelector<HTMLElement>(".pcl5__error")!;
    const result = root.querySelector<HTMLElement>(".pcl5__result")!;
    const progress = root.querySelector<HTMLElement>(".pcl5__progress")!;
    const nav = root.querySelector<HTMLElement>(".pcl5__nav")!;
    const actions = root.querySelector<HTMLElement>(".pcl5__actions")!;
    const consigne = root.querySelector<HTMLElement>("[data-consigne]")!;
    const fill = root.querySelector<HTMLElement>("[data-fill]")!;
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const stepLabel = root.querySelector<HTMLElement>("[data-step-label]")!;
    const clusterEl = root.querySelector<HTMLElement>("[data-cluster]")!;
    const answeredEl = root.querySelector<HTMLElement>("[data-answered]")!;
    const live = root.querySelector<HTMLElement>("[data-live]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const editBtn = root.querySelector<HTMLButtonElement>("[data-edit]")!;
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const lastIndex = items.length - 1;
    const advanceDelayMs = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ? 0
      : 280;

    let index = 0;
    let advanceTimer = 0;
    let pointerOnChoice = false;

    const clearAdvance = () => {
      window.clearTimeout(advanceTimer);
    };

    const clusterFor = (itemIndex: number) =>
      clusters.find((c) => itemIndex + 1 >= c.from && itemIndex + 1 <= c.to) ?? clusters[0];

    const valueAt = (itemIndex: number) => {
      const checked = form.querySelector<HTMLInputElement>(
        `input[name="q${itemIndex + 1}"]:checked`,
      );
      return checked ? Number(checked.value) : null;
    };

    const answeredCount = () => items.reduce((n, _, i) => n + (valueAt(i) !== null ? 1 : 0), 0);

    const set = (sel: string, v: number) => {
      root.querySelector(sel)!.textContent = String(v);
    };

    const showStep = (announce: boolean) => {
      items.forEach((item, i) => {
        const current = i === index;
        item.toggleAttribute("data-current", current);
        item.hidden = !current;
      });
      consigne.hidden = index > 0;
      const answered = answeredCount();
      const cluster = clusterFor(index);
      const currentValue = valueAt(index);
      stepLabel.textContent = `Question ${index + 1} sur ${items.length}`;
      clusterEl.textContent = cluster.label;
      answeredEl.textContent = String(answered);
      fill.style.width = `${(answered / items.length) * 100}%`;
      track.setAttribute("aria-valuenow", String(answered));
      prevBtn.disabled = index === 0;
      nextBtn.disabled = currentValue === null;
      nextBtn.textContent = index === lastIndex ? "Voir mon résultat" : "Continuer";
      if (announce) {
        live.textContent = `Question ${index + 1} sur ${items.length}, ${cluster.label}`;
        progress.scrollIntoView({ behavior: "smooth", block: "nearest" });
        items[index].querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
      }
    };

    const collect = () => {
      const values: number[] = [];
      const missing: number[] = [];
      items.forEach((item, i) => {
        const value = valueAt(i);
        if (value === null) {
          values.push(0);
          missing.push(i + 1);
          item.setAttribute("data-missing", "");
        } else {
          values.push(value);
          item.removeAttribute("data-missing");
        }
      });
      return { values, missing };
    };

    const showResult = (values: number[]) => {
      const sum = (from: number, to: number) =>
        values.slice(from - 1, to).reduce((a, b) => a + b, 0);
      const total = sum(1, 20);

      set("[data-total]", total);
      set('[data-cluster-score="b"]', sum(1, 5));
      set('[data-cluster-score="c"]', sum(6, 7));
      set('[data-cluster-score="d"]', sum(8, 14));
      set('[data-cluster-score="e"]', sum(15, 20));
      root.querySelector("[data-message]")!.textContent =
        total >= 33
          ? "Votre score se situe au-dessus du seuil de repérage (33). Il peut être utile d’en parler avec un(e) psychologue ou un(e) médecin pour faire le point."
          : "Votre score se situe en dessous du seuil de repérage (33). Si vous ressentez malgré tout une gêne, n’hésitez pas à en parler à un(e) professionnel(le).";

      error.hidden = true;
      form.hidden = true;
      result.hidden = false;
      result.removeAttribute("inert");
      result.focus();
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const goToMissing = (missing: number[]) => {
      error.hidden = false;
      error.textContent =
        missing.length === 1
          ? `Il reste la question ${missing[0]} à renseigner.`
          : `Merci de répondre à toutes les questions (manquantes : ${missing.join(", ")}).`;
      result.hidden = true;
      result.setAttribute("inert", "");
      form.hidden = false;
      index = missing[0] - 1;
      showStep(true);
    };

    root.dataset.stepped = "";
    progress.hidden = false;
    nav.hidden = false;
    actions.hidden = true;
    items.forEach((item) => {
      item.tabIndex = -1;
    });
    showStep(false);

    const goNext = () => {
      clearAdvance();
      if (valueAt(index) === null) return;
      if (index === lastIndex) {
        form.requestSubmit();
        return;
      }
      index += 1;
      showStep(true);
    };

    form.addEventListener("change", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || input.type !== "radio") return;
      const item = input.closest<HTMLElement>("[data-item]");
      item?.removeAttribute("data-missing");
      error.hidden = true;
      showStep(false);
    });

    form.addEventListener("pointerdown", (event) => {
      const input = event.target;
      pointerOnChoice =
        input instanceof HTMLInputElement &&
        input.type === "radio" &&
        event.pointerType !== "";
    });

    form.addEventListener("click", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || input.type !== "radio") return;
      if (!pointerOnChoice) return;
      pointerOnChoice = false;
      clearAdvance();
      advanceTimer = window.setTimeout(goNext, advanceDelayMs);
    });

    form.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      if (!(event.target instanceof HTMLInputElement) || event.target.type !== "radio") return;
      if (nextBtn.disabled) return;
      event.preventDefault();
      goNext();
    });

    prevBtn.addEventListener("click", () => {
      if (index === 0) return;
      clearAdvance();
      index -= 1;
      showStep(true);
    });

    nextBtn.addEventListener("click", () => {
      goNext();
    });

    editBtn.addEventListener("click", () => {
      result.hidden = true;
      result.setAttribute("inert", "");
      form.hidden = false;
      index = lastIndex;
      showStep(true);
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const { values, missing } = collect();
      if (missing.length) {
        goToMissing(missing);
        return;
      }
      showResult(values);
    });

    form.addEventListener("reset", () => {
      clearAdvance();
      index = 0;
      error.hidden = true;
      result.hidden = true;
      result.setAttribute("inert", "");
      form.hidden = false;
      items.forEach((item) => item.removeAttribute("data-missing"));
      window.setTimeout(() => showStep(true), 0);
    });
  }
</script>
