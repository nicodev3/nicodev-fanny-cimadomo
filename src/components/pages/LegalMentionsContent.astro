---
import { Building2, Cookie, Server, ShieldCheck } from "@lucide/astro";
import { client } from "../../lib/client";
import { businessAddressText } from "../../lib/client/businessAddress";
import {
  LEGAL_HOSTING_ADDRESS,
  LEGAL_HOSTING_NAME,
  LEGAL_NO_TRACKING_NOTICE,
} from "../../lib/constants";

const b = client.business;
const license = client.credentials.license;
const regLabel = license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
---

<div class="card-grid card-grid--2 legal-grid">
  <section class="info-card" data-component="legal.editor" aria-labelledby="legal-editor">
    <h2 id="legal-editor" class="info-card__title">
      <Building2 size={18} aria-hidden="true" />
      Éditeur du site
    </h2>
    <dl class="definition-list">
      <div>
        <dt>Responsable</dt>
        <dd>{b.fullName} — {b.title}</dd>
      </div>
      <div>
        <dt>Adresse</dt>
        <dd>{businessAddressText(b)}</dd>
      </div>
      <div>
        <dt>E-mail</dt>
        <dd><a href={`mailto:${b.email}`}>{b.email}</a></dd>
      </div>
      {
        b.siret && (
          <div>
            <dt>SIRET</dt>
            <dd>{b.siret}</dd>
          </div>
        )
      }
      {
        license.rppsOrAdeli && (
          <div>
            <dt>{regLabel}</dt>
            <dd>{license.rppsOrAdeli}</dd>
          </div>
        )
      }
    </dl>
  </section>

  <section class="info-card" data-component="legal.hosting" aria-labelledby="legal-hosting">
    <h2 id="legal-hosting" class="info-card__title">
      <Server size={18} aria-hidden="true" />
      Hébergement
    </h2>
    <dl class="definition-list">
      <div>
        <dt>Hébergeur</dt>
        <dd>{LEGAL_HOSTING_NAME}</dd>
      </div>
      <div>
        <dt>Adresse</dt>
        <dd>{LEGAL_HOSTING_ADDRESS}</dd>
      </div>
    </dl>
  </section>

  <section
    id="donnees-personnelles"
    class="info-card"
    data-component="legal.privacy"
    aria-labelledby="legal-privacy"
  >
    <h2 id="legal-privacy" class="info-card__title">
      <ShieldCheck size={18} aria-hidden="true" />
      Données personnelles
    </h2>
    <p>
      Les informations transmises via email ou prise de rendez-vous sont utilisées uniquement pour
      répondre à votre demande. Pour toute question : <a href={`mailto:${b.email}`}>{b.email}</a>.
    </p>
  </section>

  <section class="info-card" data-component="legal.cookies" aria-labelledby="legal-cookies">
    <h2 id="legal-cookies" class="info-card__title">
      <Cookie size={18} aria-hidden="true" />
      Cookies / traceurs
    </h2>
    <p>{LEGAL_NO_TRACKING_NOTICE}</p>
  </section>
</div>
