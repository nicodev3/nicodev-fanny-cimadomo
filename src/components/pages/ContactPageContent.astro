---
import { Clock } from "@lucide/astro";
import ContactCard from "../ContactCard.astro";
import ContactHoursBlock from "../ContactHoursBlock.astro";
import ContactForm from "../ContactForm.astro";
import FaqSection from "../FaqSection.astro";
import { enabledContactHoursRows } from "../../lib/client/contactHours";
import { client } from "../../lib/client";

const hasHours = enabledContactHoursRows(client.contact.hours).length > 0;
const waitingListNote = client.practice.waitingListNote ?? "";
---

<section class="contact-layout" data-component="contact.info" aria-label="Coordonnées">
  <ContactCard stacked />

  <div class="contact-layout__side">
    {
      hasHours && (
        <div class="info-card" data-component="contact.hours">
          <span class="icon-badge" aria-hidden="true">
            <Clock size={20} />
          </span>
          <ContactHoursBlock />
          {waitingListNote && <p class="note">{waitingListNote}</p>}
        </div>
      )
    }

    {
      waitingListNote && !hasHours && (
        <div class="info-card" data-component="contact.waiting">
          <p>{waitingListNote}</p>
        </div>
      )
    }
  </div>
</section>

{client.contact.channels.selected.includes("form") && <ContactForm />}

<FaqSection />
