---
import { BookOpen, GraduationCap, Users } from "@lucide/astro";
import { client } from "../lib/client";

const c = client.credentials;
const b = client.business;
const licenseKindLabel = c.license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
const highlights = [
  b.title,
  c.license.rppsOrAdeli ? `${licenseKindLabel} : ${c.license.rppsOrAdeli}` : "",
  typeof c.experienceYears === "number" ? `${c.experienceYears} ans d'expérience` : "",
].filter(Boolean);
---

<section
  class="surface-panel"
  data-component="panel.credentials"
  aria-labelledby="credentials-title"
>
  <div class="section-head">
    <p class="section-eyebrow">Parcours</p>
    <h2 id="credentials-title">Formations et qualifications</h2>
    <ul class="chip-list" aria-label="En bref">
      {highlights.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="card-grid card-grid--2">
    {
      c.degrees.length > 0 && (
        <div class="info-card" data-component="credentials.degrees">
          <span class="icon-badge" aria-hidden="true">
            <GraduationCap size={20} />
          </span>
          <h3>Diplômes</h3>
          <ol class="timeline">
            {c.degrees.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.institution && <span class="timeline__meta">{item.institution}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      c.trainings.length > 0 && (
        <div class="info-card" data-component="credentials.trainings">
          <span class="icon-badge" aria-hidden="true">
            <BookOpen size={20} />
          </span>
          <h3>Formations complémentaires</h3>
          <ol class="timeline">
            {c.trainings.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.provider && <span class="timeline__meta">{item.provider}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>

  {
    c.affiliations.length > 0 && (
      <div class="info-card info-card--inline" data-component="credentials.affiliations">
        <span class="icon-badge" aria-hidden="true">
          <Users size={20} />
        </span>
        <div>
          <h3>Affiliations</h3>
          <ul class="chip-list">
            {c.affiliations.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    )
  }
</section>
