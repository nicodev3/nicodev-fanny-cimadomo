---
import { client } from "../lib/client";
import { professionDeontologieFooterLink } from "../lib/client/professionCopy";

const c = client.credentials;
const deontologie = professionDeontologieFooterLink(client.profession);

/** Missions explicitement hors institutions enfance / familles. */
const ADULT_EXPERIENCE = /armée|armées|réserviste|jury de concours/i;

const experienceClusters = [
  {
    heading: "Enfance et familles",
    items: c.professionalExperiences.filter((item) => !ADULT_EXPERIENCE.test(item)),
  },
  {
    heading: "Adultes",
    items: c.professionalExperiences.filter((item) => ADULT_EXPERIENCE.test(item)),
  },
].filter((cluster) => cluster.items.length > 0);

const trainingGroups = Object.entries(
  c.trainings.reduce<Record<string, typeof c.trainings>>((groups, item) => {
    const year = item.year || "Date non précisée";
    (groups[year] ??= []).push(item);
    return groups;
  }, {}),
).sort(([yearA], [yearB]) => {
  const numericA = Number(yearA);
  const numericB = Number(yearB);
  if (Number.isFinite(numericA) && Number.isFinite(numericB)) return numericB - numericA;
  if (Number.isFinite(numericA)) return -1;
  if (Number.isFinite(numericB)) return 1;
  return 0;
});
---

<section
  class="credentials"
  data-component="panel.credentials"
  aria-labelledby="credentials-title"
>
  <h2 id="credentials-title">Formations et qualifications</h2>
  <div class="credentials__intro">
    <p class="credentials__note">
      Mon parcours en institution m’a amenée à accompagner des enfants, des adolescents et des
      familles — en milieu scolaire, judiciaire, en protection de l’enfance ou à l’hôpital.
      Aujourd’hui, mon cabinet accueille les adultes uniquement&nbsp;: ces expériences et d’autres
      formations sur l’enfance nourrissent ma pratique clinique, sans ouvrir de suivi pour les
      mineurs.
    </p>
    {
      deontologie && (
        <p class="credentials__note">
          Je me forme en continu pour actualiser mes compétences, conformément aux exigences du{" "}
          <a href={deontologie.href} target="_blank" rel="noopener noreferrer">
            {deontologie.label}
            <span class="sr-only">(nouvel onglet)</span>
          </a>
          .
        </p>
      )
    }
  </div>

  <div class="credentials__lists">
    {
      c.degrees.length > 0 && (
        <div data-component="credentials.degrees">
          <h3>Diplômes</h3>
          <ol class="timeline">
            {c.degrees.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.institution && <span class="timeline__meta">{item.institution}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      experienceClusters.length > 0 && (
        <div
          class="credentials__section credentials__section--secondary"
          data-component="credentials.experiences"
        >
          <h3>Expériences professionnelles</h3>
          <div class="credentials__clusters">
            {experienceClusters.map((cluster) => (
              <section class="credentials__cluster">
                <h4>{cluster.heading}</h4>
                <ul class="credentials__roles">
                  {cluster.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      )
    }

    {
      trainingGroups.length > 0 && (
        <div
          class="credentials__section credentials__section--secondary"
          data-component="credentials.trainings"
        >
          <h3>Formations continues</h3>
          <ol class="credentials__training-groups">
            {trainingGroups.map(([year, items]) => (
              <li class="credentials__training-group">
                <h4 class="credentials__training-year">{year}</h4>
                <ul class="credentials__training-list">
                  {items.map((item) => (
                    <li>
                      <span class="credentials__training-label">{item.label}</span>
                      {item.provider && (
                        <span class="credentials__training-provider">{item.provider}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>

  {
    c.affiliations.length > 0 && (
      <div data-component="credentials.affiliations">
        <h3>Affiliations</h3>
        <ul>
          {c.affiliations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
