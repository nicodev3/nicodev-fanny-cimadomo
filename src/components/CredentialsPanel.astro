---
import { client } from "../lib/client";
import { professionDeontologieFooterLink } from "../lib/client/professionCopy";

const c = client.credentials;
const deontologie = professionDeontologieFooterLink(client.profession);

function isPediatricTraining(label: string): boolean {
  return /enfant|adolescent|enfance|mineur|pédiat/i.test(label);
}

/** Vedette : approches adultes (EMDR, PSSM, systémie) — jamais le pédiatrique, même si « TSPT » apparaît dans l’intitulé. */
function isFeaturedTraining(label: string): boolean {
  if (isPediatricTraining(label)) return false;
  return /emdr|premiers secours en santé mentale|systém/i.test(label);
}

const featuredTrainings = c.trainings.filter((item) => isFeaturedTraining(item.label));
const otherTrainings = c.trainings.filter((item) => !isFeaturedTraining(item.label));
---

<section
  class="credentials"
  data-component="panel.credentials"
  aria-labelledby="credentials-title"
>
  <h2 id="credentials-title">Formations et qualifications</h2>
  <div class="credentials__intro">
    <p class="credentials__note">
      Mon parcours en institution m’a amenée à accompagner des enfants, des adolescents et des
      familles — en milieu scolaire, judiciaire, en protection de l’enfance ou à l’hôpital.
      Aujourd’hui, mon cabinet accueille les adultes uniquement&nbsp;: ces expériences et d’autres
      formations sur l’enfance nourrissent ma pratique clinique, sans ouvrir de suivi pour les
      mineurs.
    </p>
    {
      deontologie && (
        <p class="credentials__note">
          Je me forme en continu pour actualiser mes compétences, conformément aux exigences du{" "}
          <a href={deontologie.href} target="_blank" rel="noopener noreferrer">
            {deontologie.label}
            <span class="sr-only">(nouvel onglet)</span>
          </a>
          .
        </p>
      )
    }
  </div>

  <div class="credentials__lists">
    {
      c.degrees.length > 0 && (
        <div data-component="credentials.degrees">
          <h3>Diplômes</h3>
          <ol class="timeline">
            {c.degrees.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.institution && <span class="timeline__meta">{item.institution}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      featuredTrainings.length > 0 && (
        <div data-component="credentials.trainings">
          <h3>Formations en lien avec ma pratique actuelle</h3>
          <ol class="timeline">
            {featuredTrainings.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.provider && <span class="timeline__meta">{item.provider}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      c.professionalExperiences.length > 0 && (
        <details
          class="credentials__block credentials__block--full credentials__fold"
          data-component="credentials.experiences"
        >
          <summary>
            <span class="credentials__fold-heading">Expériences professionnelles</span>
            <span class="credentials__fold-hint">Parcours en institution (enfance, familles)</span>
          </summary>
          <ul class="credentials__roles">
            {c.professionalExperiences.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </details>
      )
    }

    {
      otherTrainings.length > 0 && (
        <details
          class="credentials__block credentials__block--full credentials__fold"
          data-component="credentials.trainings-more"
        >
          <summary>
            <span class="credentials__fold-heading">Autres formations continues</span>
            <span class="credentials__fold-hint">
              Contexte institutionnel enfance et adolescence — hors suivi de mineurs au cabinet
            </span>
          </summary>
          <ol class="timeline timeline--secondary">
            {otherTrainings.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.provider && <span class="timeline__meta">{item.provider}</span>}
              </li>
            ))}
          </ol>
        </details>
      )
    }
  </div>

  {
    c.affiliations.length > 0 && (
      <div data-component="credentials.affiliations">
        <h3>Affiliations</h3>
        <ul>
          {c.affiliations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
