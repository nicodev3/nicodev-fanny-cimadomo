---
import { client } from "../lib/client";

const c = client.credentials;

function isPediatricTraining(label: string): boolean {
  return /enfant|adolescent|enfance|mineur|pédiat/i.test(label);
}

/** Vedette : approches adultes (EMDR, PSSM, systémie) — jamais le pédiatrique, même si « TSPT » apparaît dans l’intitulé. */
function isFeaturedTraining(label: string): boolean {
  if (isPediatricTraining(label)) return false;
  return /emdr|premiers secours en santé mentale|systém/i.test(label);
}

const featuredTrainings = c.trainings.filter((item) => isFeaturedTraining(item.label));
const otherTrainings = c.trainings.filter((item) => !isFeaturedTraining(item.label));
---

<section
  class="credentials"
  data-component="panel.credentials"
  aria-labelledby="credentials-title"
>
  <h2 id="credentials-title">Formations et qualifications</h2>
  <p class="credentials__note">
    Mon cabinet accueille les adultes uniquement. D’autres formations portent sur l’enfance ou
    l’adolescence&nbsp;: elles enrichissent ma pratique, sans ouvrir de suivi pour les&nbsp;mineurs.
  </p>

  <div class="credentials__lists">
    {
      c.degrees.length > 0 && (
        <div data-component="credentials.degrees">
          <h3>Diplômes</h3>
          <ol class="timeline">
            {c.degrees.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.institution && <span class="timeline__meta">{item.institution}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      featuredTrainings.length > 0 && (
        <div data-component="credentials.trainings">
          <h3>Formations en lien avec ma pratique actuelle</h3>
          <ol class="timeline">
            {featuredTrainings.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.provider && <span class="timeline__meta">{item.provider}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      otherTrainings.length > 0 && (
        <div
          class="credentials__block credentials__block--full"
          data-component="credentials.trainings-more"
        >
          <h3>Autres formations continues</h3>
          <ol class="timeline timeline--secondary">
            {otherTrainings.map((item) => (
              <li>
                {item.year && <span class="timeline__year">{item.year}</span>}
                <span class="timeline__label">{item.label}</span>
                {item.provider && <span class="timeline__meta">{item.provider}</span>}
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>

  {
    c.affiliations.length > 0 && (
      <div data-component="credentials.affiliations">
        <h3>Affiliations</h3>
        <ul>
          {c.affiliations.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>
