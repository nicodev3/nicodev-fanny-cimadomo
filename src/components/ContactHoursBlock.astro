---
import { Clock } from "@lucide/astro";
import { enabledContactHoursRows } from "../lib/client/contactHours";
import { client } from "../lib/client";

const hoursRows = enabledContactHoursRows(client.contact.hours);
---

{
  hoursRows.length > 0 && (
    <div data-component="contact.hours-block">
      <h2 class="info-card__title">
        <Clock size={18} aria-hidden="true" />
        Horaires
      </h2>
      <table>
        <tbody>
          {hoursRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.value.replace(/(\d)\s*-\s*(?=\d)/g, "$1–")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
