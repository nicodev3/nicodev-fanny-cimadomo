---
import { ArrowRight, Clock, MapPin, Phone, ShieldCheck } from "@lucide/astro";
import { Image } from "astro:assets";
import { client } from "../../lib/client";
import { enabledContactHoursRows } from "../../lib/client/contactHours";
import photo from "../../assets/Fanny-CIMADOMO.webp";

const { business, credentials, contact } = client;
const registrationLabel = credentials.license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
const degree = credentials.degrees[0];
const hours = enabledContactHoursRows(contact.hours);
const phoneHref = `tel:${business.phone.replace(/[^\d+]/g, "")}`;
---

<aside class="hero-profile" aria-labelledby="practitioner-name">
  <div class="hero-profile__photo">
    <Image
      src={photo}
      alt={`Portrait de ${business.fullName}`}
      width={272}
      height={272}
      densities={[1, 2]}
      loading="eager"
    />
  </div>

  <p class="hero-profile__role">Psychologue clinicienne · {business.city}</p>
  <h2 id="practitioner-name" class="hero-profile__name">{business.fullName}</h2>

  <p class="hero-profile__bio">
    J’accompagne les adultes face à l’anxiété, au psychotraumatisme, au deuil ou à l’épuisement,
    dans un cadre confidentiel et sans jugement.
  </p>

  <ul class="hero-profile__facts">
    {
      credentials.license.rppsOrAdeli && (
        <li>
          <ShieldCheck size={16} aria-hidden="true" />
          <span>
            {registrationLabel} {credentials.license.rppsOrAdeli}
            {degree && ` · ${degree.institution}`}
          </span>
        </li>
      )
    }
    <li>
      <MapPin size={16} aria-hidden="true" />
      <span>{business.addressLine1}, {business.postalCode} {business.city}</span>
    </li>
    {
      hours.length > 0 && (
        <li>
          <Clock size={16} aria-hidden="true" />
          <span>{hours.map((h) => `${h.label} ${h.value}`).join(" · ")}</span>
        </li>
      )
    }
  </ul>

  <div class="hero-profile__actions">
    <a href="/a-propos/" class="cta-primary cta-primary--sm">
      Découvrir mon parcours
      <ArrowRight size={16} aria-hidden="true" />
    </a>
    <a href={phoneHref} class="cta-secondary cta-secondary--sm" aria-label={`Appeler le ${business.phone}`}>
      <Phone size={16} aria-hidden="true" />
      {business.phone}
    </a>
  </div>
</aside>
