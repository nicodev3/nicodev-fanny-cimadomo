---
import { ArrowRight, GraduationCap, MapPin, ShieldCheck } from "@lucide/astro";
import { Image } from "astro:assets";
import { client } from "../../lib/client";
import { professionSupportsMonSoutienPsy } from "../../lib/client/professionCopy";
import photo from "../../assets/Fanny-CIMADOMO.webp";

const { business, credentials } = client;
const registrationLabel = credentials.license.registrationLabel === "rpps" ? "RPPS" : "ADELI";
const showMonSoutienPsyAbsent =
  professionSupportsMonSoutienPsy(client.profession) &&
  !client.practice.reimbursement.monSoutienPsy.enabled;
const degree = credentials.degrees[0];
const degreeLine = degree
  ? /psychologie légale/i.test(degree.label)
    ? "Master 2 psychologie clinique · psychologie légale"
    : degree.label
  : null;
---

<aside class="hero-profile" aria-labelledby="practitioner-name">
  <div class="hero-profile__photo">
    <Image
      src={photo}
      alt={`Portrait de ${business.fullName}`}
      width={272}
      height={272}
      densities={[1, 2]}
      loading="eager"
    />
  </div>

  <h2 id="practitioner-name" class="hero-profile__name">{business.fullName}</h2>

  <ul class="hero-profile__facts">
    {
      showMonSoutienPsyAbsent ? (
        <li>
          <ShieldCheck size={16} aria-hidden="true" />
          <span>Je ne propose pas le dispositif Mon Soutien Psy.</span>
        </li>
      ) : (
        credentials.license.rppsOrAdeli && (
          <li>
            <ShieldCheck size={16} aria-hidden="true" />
            <span>
              {registrationLabel} {credentials.license.rppsOrAdeli}
            </span>
          </li>
        )
      )
    }
    {
      degreeLine && (
        <li>
          <GraduationCap size={16} aria-hidden="true" />
          <span>{degreeLine}</span>
        </li>
      )
    }
    <li>
      <MapPin size={16} aria-hidden="true" />
      <span>{business.addressLine1}, {business.postalCode} {business.city}</span>
    </li>
  </ul>

  <div class="hero-profile__actions">
    <a href="/a-propos/" class="cta-secondary cta-secondary--sm">
      Découvrir le parcours
      <ArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</aside>
