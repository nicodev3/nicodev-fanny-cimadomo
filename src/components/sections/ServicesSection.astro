---
interface Props {
  /** Page listant le détail des motifs. */
  detailsPageHref?: string;
}

const { detailsPageHref = "/pourquoi-consulter/" } = Astro.props;

const groups = [
  {
    title: "Anxiété, peurs et sommeil",
    text: "Quand l’angoisse, les phobies ou le sommeil prennent trop de place.",
  },
  {
    title: "Après un choc, un deuil, des violences",
    text: "Trauma, harcèlement, violences, relations très dégradées.",
  },
  {
    title: "Humeur, isolement et estime de soi",
    text: "Dépression, solitude, questionnement identitaire.",
  },
  {
    title: "Souffrance au travail",
    text: "Épuisement professionnel, reconversion.",
  },
];
---

<section class="space-y-10" data-component="section.services">
  <div class="max-w-xl space-y-4">
    <h2>Pourquoi consulter</h2>
    <p>
      Quelques situations fréquentes au cabinet. La liste complète des motifs est sur une page dédiée.
    </p>
  </div>
  <ul>
    {
      groups.map((group) => (
        <li>
          <h3>{group.title}</h3>
          <p>{group.text}</p>
        </li>
      ))
    }
  </ul>
  <p>
    <a href={detailsPageHref} class="cta-secondary cta-secondary--sm">Tous les motifs</a>
  </p>
</section>
