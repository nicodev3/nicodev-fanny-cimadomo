---
import Header from "./Header.astro";
import HeroSection from "./sections/HeroSection.astro";
import PractitionerCard from "./sections/PractitionerCard.astro";
import ServicesSection from "./sections/ServicesSection.astro";
import ContactEmergencyBlock from "./ContactEmergencyBlock.astro";
import FaqSection from "./FaqSection.astro";
---

<Header />

<main id="contenu" tabindex="-1" class="site-container" data-component="home-page">
  <section data-component="section.hero">
    <div data-component="hero-layout">
      <PractitionerCard />
      <HeroSection />
    </div>
  </section>
  <section data-component="section.services-wrapper">
    <ServicesSection />
  </section>
  <ContactEmergencyBlock class="my-10" idPrefix="home-emergency" />
  <FaqSection class="my-10" />
</main>
