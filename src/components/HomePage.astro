---
import Header from "./Header.astro";
import HeroSection from "./sections/HeroSection.astro";
import PractitionerCard from "./sections/PractitionerCard.astro";
import ServicesSection from "./sections/ServicesSection.astro";
import FaqSection from "./FaqSection.astro";
import MonSoutienPsyCallout from "./MonSoutienPsyCallout.astro";
---

<Header />

<main id="contenu" tabindex="-1" class="site-container" data-component="home-page">
  <section class="section-spacing" data-component="section.hero">
    <div data-component="hero-layout">
      <HeroSection />
      <PractitionerCard />
    </div>
  </section>
  <section data-component="section.services-wrapper">
    <ServicesSection />
  </section>
  <MonSoutienPsyCallout class="my-10" headingLevel={2} />
  <FaqSection class="my-10" />
</main>
