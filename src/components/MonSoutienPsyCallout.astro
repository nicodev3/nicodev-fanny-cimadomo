---
import { client } from "../lib/client";
import { professionSupportsMonSoutienPsy } from "../lib/client/professionCopy.ts";

interface Props {
  class?: string;
  headingLevel?: 2 | 3 | 4;
}

const { class: className, headingLevel = 3 } = Astro.props;
const msp = client.practice.reimbursement.monSoutienPsy;
const professionAllowsMsp = professionSupportsMonSoutienPsy(client.profession);
const showMsp = professionAllowsMsp && msp.enabled;
const showAbsent = professionAllowsMsp && !msp.enabled;
const HeadingTag = `h${headingLevel}` as "h2" | "h3" | "h4";
---

{
  showMsp && (
    <section
      class:list={["page-block", className]}
      data-component="MonSoutienPsyCallout"
      aria-labelledby="msp-title"
    >
      <HeadingTag id="msp-title">Mon Soutien Psy</HeadingTag>
      <p>
        Le dispositif Mon Soutien Psy permet, sous conditions et sur prescription médicale, un
        accompagnement psychologique pris en charge.
      </p>
      <p>{msp.note.trim()}</p>
    </section>
  )
}

{
  showAbsent && (
    <p class:list={["msp-absent", className]} data-component="msp.absent">
      Je ne propose pas le dispositif Mon Soutien Psy.
    </p>
  )
}
