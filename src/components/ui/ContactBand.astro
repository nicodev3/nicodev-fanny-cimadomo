---
import { ArrowRight, Mail } from "@lucide/astro";
import { SITE_BOOKING_SECONDARY_HREF, SITE_BOOKING_SECONDARY_LABEL } from "../../lib/constants";

interface Props {
  title?: string;
  text?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title = "Une question avant de prendre rendez-vous ?",
  text = "Écrivez-moi : je vous réponds dans les meilleurs délais.",
  ctaHref = SITE_BOOKING_SECONDARY_HREF,
  ctaLabel = SITE_BOOKING_SECONDARY_LABEL,
} = Astro.props;
const headingId = "contact-band-title";
/** Enveloppe pour un contact écrit ; flèche pour un simple renvoi vers une autre page. */
const isContactLink = ctaHref === SITE_BOOKING_SECONDARY_HREF;
---

<section class="contact-band" data-component="ui.contact-band" aria-labelledby={headingId}>
  <div>
    <h2 id={headingId}>{title}</h2>
    <p>{text}</p>
  </div>
  <a href={ctaHref} class="cta-primary cta-primary--sm">
    {isContactLink && <Mail size={16} aria-hidden="true" />}
    {ctaLabel}
    {!isContactLink && <ArrowRight size={16} aria-hidden="true" />}
  </a>
</section>
