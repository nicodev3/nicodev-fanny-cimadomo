---
import { client } from "../lib/client";
import { resolvedFaqEntries } from "../lib/client/faqPresets.ts";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const items = resolvedFaqEntries(client);
const faqPageJsonLd =
  items.length === 0
    ? ""
    : JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: items.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      }).replace(/</g, "\\u003c");
---

<section
  class:list={["page-block", className]}
  data-component="panel.faq"
  aria-labelledby="faq-heading"
>
  <h2 id="faq-heading">Questions fréquentes</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details data-component="faq.item">
          <summary>
            <span>{item.question}</span>
            <span class="faq-toggle" aria-hidden="true"></span>
          </summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
  {faqPageJsonLd && <script is:inline type="application/ld+json" set:html={faqPageJsonLd} />}
</section>
