---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { client } from "../lib/client";

interface Props {
  title: string;
  description?: string;
  /** Chapô sous le titre ; par défaut la description SEO. */
  intro?: string;
  /** Petite étiquette affichée au-dessus du titre. */
  eyebrow?: string;
  /** La page fournit son propre en-tête (ex. à propos avec portrait). */
  hidePageHeader?: boolean;
  ogType?: "website" | "article";
  /** Repris tel quel depuis le frontmatter `updatedAt`, s’il existe. */
  modifiedTime?: string;
}

const {
  title,
  description = "",
  intro = description,
  eyebrow = "",
  hidePageHeader = false,
  ogType = "website",
  modifiedTime,
} = Astro.props;
---

<BaseLayout
  title={`${title} — ${client.seo.siteName}`}
  description={description}
  ogType={ogType}
  modifiedTime={modifiedTime}
  articleTitle={ogType === "article" ? title : undefined}
>
  <Header />
  <Breadcrumb currentLabel={title} />

  <main id="contenu" tabindex="-1" class="site-container page" data-component="page">
    {
      !hidePageHeader && (
        <header
          class:list={[
            "page-header page-hero",
            Astro.slots.has("actions") && "page-header--actions",
          ]}
          data-component="page.header"
        >
          {eyebrow && <p class="section-eyebrow section-eyebrow--pill">{eyebrow}</p>}
          <h1>{title}</h1>
          {intro && <p class="lead">{intro}</p>}
          {Astro.slots.has("actions") && (
            <div class="page-header__actions">
              <slot name="actions" />
            </div>
          )}
        </header>
      )
    }

    <div class="page-content">
      <slot />
    </div>
  </main>
</BaseLayout>
