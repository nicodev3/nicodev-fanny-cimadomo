---
import { getCollection, render } from "astro:content";
import Pcl5Questionnaire from "../components/Pcl5Questionnaire.astro";
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import ContactBand from "../components/ui/ContactBand.astro";
import PageAside from "../components/ui/PageAside.astro";
import { client } from "../lib/client";
import { isPublishedEntry } from "../lib/contentNavigation";
import {
  REGISTERED_PRACTICE_PAGES,
  practicePageContentId,
  practicePageEntryMatchesContentId,
} from "../lib/practicePageRegistry";
import integrativeHero from "../assets/approche-integrative.png";
import emdrHero from "../assets/emdr.png";
import tccHero from "../assets/tcc.png";
import type { ImageMetadata } from "astro";

const PRACTICE_PAGE_HERO: Record<string, { image: ImageMetadata; alt: string }> = {
  "approche-integrative": {
    image: integrativeHero,
    alt: "Illustration lumineuse : une silhouette à genoux tient une tresse de fils colorés qui sort d’un profil de visage aux formes pastel.",
  },
  emdr: {
    image: emdrHero,
    alt: "Illustration lumineuse : une silhouette assise en méditation, reliée par un fil corail et un arc de points à un profil de visage aux touches pastel.",
  },
  "therapies-tcc": {
    image: tccHero,
    alt: "Illustration : une silhouette dénoue un fil rouge issu d’un enchevêtrement de pensées dans un profil de visage.",
  },
};

export async function getStaticPaths() {
  const entries = await getCollection("practicePages", isPublishedEntry);

  return REGISTERED_PRACTICE_PAGES.filter(
    (page) => client.practicePageEnabled[page.id] === true,
  ).map((page) => {
    const contentId = practicePageContentId(page.slug);
    const entry = entries.find((e) => practicePageEntryMatchesContentId(e.id, contentId));
    if (!entry) {
      throw new Error(
        `[practicePages] Page pratique "${page.id}" activée (client.practicePageEnabled) mais fichier manquant : src/content/practice-pages/${contentId}`,
      );
    }
    return {
      params: { practicePage: page.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { practicePage } = Astro.params;
const { Content } = await render(entry);
const hero = practicePage ? PRACTICE_PAGE_HERO[practicePage] : undefined;
---

<StandardPageLayout
  title={entry.data.title}
  description={entry.data.description ?? ""}
  eyebrow="Mes pratiques"
  heroImage={hero?.image}
  heroImageAlt={hero?.alt}
>
  <div class="reading-layout">
    <PageAside />
    <article class="content-rich prose-card" data-component="content.practice-page">
      <Content />
    </article>
  </div>
  {entry.data.questionnaire === "pcl5" && <Pcl5Questionnaire />}
  <ContactBand />
</StandardPageLayout>
