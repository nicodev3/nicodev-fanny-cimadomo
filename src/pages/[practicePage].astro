---
import { getCollection, render } from "astro:content";
import Pcl5Questionnaire from "../components/Pcl5Questionnaire.astro";
import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import ContactBand from "../components/ui/ContactBand.astro";
import PageAside from "../components/ui/PageAside.astro";
import { client } from "../lib/client";
import { isPublishedEntry } from "../lib/contentNavigation";
import {
  REGISTERED_PRACTICE_PAGES,
  practicePageContentId,
  practicePageEntryMatchesContentId,
} from "../lib/practicePageRegistry";
import { getPracticePageHero } from "../lib/practicePageHeroImages";

export async function getStaticPaths() {
  const entries = await getCollection("practicePages", isPublishedEntry);

  return REGISTERED_PRACTICE_PAGES.filter(
    (page) => client.practicePageEnabled[page.id] === true,
  ).map((page) => {
    const contentId = practicePageContentId(page.slug);
    const entry = entries.find((e) => practicePageEntryMatchesContentId(e.id, contentId));
    if (!entry) {
      throw new Error(
        `[practicePages] Page pratique "${page.id}" activée (client.practicePageEnabled) mais fichier manquant : src/content/practice-pages/${contentId}`,
      );
    }
    return {
      params: { practicePage: page.slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { practicePage } = Astro.params;
const { Content } = await render(entry);
const hero = practicePage ? getPracticePageHero(practicePage) : undefined;
---

<StandardPageLayout
  title={entry.data.title}
  description={entry.data.description ?? ""}
  heroImage={hero?.image}
  heroImageAlt={hero?.alt}
>
  <div class="reading-layout">
    <PageAside />
    <article class="content-rich prose-card" data-component="content.practice-page">
      <Content />
    </article>
  </div>
  {entry.data.questionnaire === "pcl5" && <Pcl5Questionnaire />}
  <ContactBand />
</StandardPageLayout>
