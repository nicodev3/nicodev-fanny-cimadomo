---
export const pageNav = {
  navLabel: "Contact",
  /** Toujours en dernier dans le menu. */
  navOrder: 100,
};

import StandardPageLayout from "../layouts/StandardPageLayout.astro";
import ContactPageContent from "../components/pages/ContactPageContent.astro";
import BookingActions from "../components/ui/BookingActions.astro";
import contactHero from "../assets/contact.png";
---

<StandardPageLayout
  title="Contact"
  description="Retrouvez ici les informations pour prendre rendez-vous, accéder au cabinet et me contacter."
  heroImage={contactHero}
  heroImageAlt="Illustration : un téléphone, une enveloppe et un calendrier dessinés, reliés par un trait pointillé corail, sur fond crème."
>
  <BookingActions slot="actions" hideContact />
  <ContactPageContent />
</StandardPageLayout>
