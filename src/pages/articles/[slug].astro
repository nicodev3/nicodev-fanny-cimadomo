---
import { getCollection, render } from "astro:content";
import StandardPageLayout from "../../layouts/StandardPageLayout.astro";
import ContactBand from "../../components/ui/ContactBand.astro";
import PageAside from "../../components/ui/PageAside.astro";
import { getPageSlug } from "../../lib/pageRoutes";
import { isPublishedEntry } from "../../lib/contentNavigation";

export async function getStaticPaths() {
  const entries = await getCollection("pages", isPublishedEntry);
  return entries.map((entry) => ({
    params: { slug: getPageSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<StandardPageLayout
  title={entry.data.title}
  description={entry.data.description ?? ""}
  ogType="article"
  modifiedTime={entry.data.updatedAt}
>
  <div class="reading-layout">
    <PageAside />
    <article class="content-rich prose-card" data-component="content.article">
      <Content />
    </article>
  </div>
  <ContactBand />
</StandardPageLayout>
